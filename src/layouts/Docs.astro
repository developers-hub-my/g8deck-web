---
/**
 * Layout for every documentation page. Pages carry prose and screenshots
 * only — the sidebar, search, contents, metadata and pagination are settled
 * here once.
 *
 * Runtime JavaScript on docs pages is limited to two progressive
 * enhancements: the search box (Search.astro) and the Copy button on code
 * blocks (below). Neither hides content; without them every page still reads
 * and navigates in full.
 */
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/docs/Search.astro';
import { docs, groups, isCurrent, SECTIONS, type DocEntry } from '../data/docs';
import { site } from '../data/site';
import '../styles/docs.css';

interface Props {
    doc: DocEntry;
    /** From the page's own Markdown, so it cannot drift from the headings. */
    headings?: MarkdownHeading[];
}

const { doc, headings = [] } = Astro.props;
const pathname = Astro.url.pathname;

/* h1 is the page title, already on screen. A reference page with dozens of
   tool headings lists its h2 groups only — a contents list longer than the
   screen is not a contents list. */
const sections = headings.filter((h) => h.depth === 2 || h.depth === 3);
const contents = sections.length > 30 ? sections.filter((h) => h.depth === 2) : sections;

const updated = new Date(doc.updated).toLocaleDateString('en-MY', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
});
const sectionLabel = SECTIONS.find((s) => s.key === doc.section)?.label;

const position = docs.findIndex((d) => isCurrent(d.href, pathname));
const previous = position > 0 ? docs[position - 1] : undefined;
const next = position >= 0 && position < docs.length - 1 ? docs[position + 1] : undefined;
---

<Base title={`${doc.title} — ${site.name} documentation`} description={doc.description}>
    <Nav />

    <main id="main" class="page docs-shell py-10 lg:py-14">
        <aside class="docs-sidebar">
            <Search id="sidebar-search" />
            <details class="docs-nav-toggle" open>
                <summary>
                    <span class="mono-label">Browse documentation</span>
                </summary>
                <nav aria-label="Documentation" class="docs-nav">
                    <a
                        href="/docs"
                        class:list={['docs-nav-link', isCurrent('/docs', pathname) && 'is-current']}
                        >Overview</a
                    >
                    {
                        groups.map((group) => (
                            <div class="docs-nav-group">
                                <p class="mono-label docs-nav-heading">{group.label}</p>
                                <ul>
                                    {group.docs.map((entry) => {
                                        const current = isCurrent(entry.href, pathname);
                                        return (
                                            <li>
                                                <a
                                                    href={entry.href}
                                                    aria-current={current ? 'page' : undefined}
                                                    class:list={[
                                                        'docs-nav-link',
                                                        current && 'is-current',
                                                    ]}
                                                >
                                                    {entry.nav ?? entry.title}
                                                </a>
                                            </li>
                                        );
                                    })}
                                </ul>
                            </div>
                        ))
                    }
                </nav>
            </details>
        </aside>

        <article class="docs-article">
            <nav aria-label="Breadcrumb" class="docs-breadcrumb mono-label">
                <a href="/docs">Docs</a>
                <span aria-hidden="true">/</span>
                <span>{sectionLabel}</span>
            </nav>
            <h1 class="docs-title">{doc.title}</h1>
            <p class="body-lg text-muted mt-4 max-w-3xl text-pretty">{doc.description}</p>
            <p class="docs-meta mono-label">
                <span>Updated {updated}</span>
                {
                    doc.generated && (
                        <span class="docs-generated">Generated from the application source</span>
                    )
                }
            </p>

            <div class="prose mt-10" data-docs-prose>
                <slot />
            </div>

            {
                (previous || next) && (
                    <nav class="docs-pager" aria-label="Previous and next page">
                        {previous ? (
                            <a href={previous.href} rel="prev" class="card docs-pager-link">
                                <span class="mono-label text-idle">Previous</span>
                                <span class="docs-pager-title">{previous.title}</span>
                            </a>
                        ) : (
                            <span />
                        )}
                        {next && (
                            <a href={next.href} rel="next" class="card docs-pager-link is-next">
                                <span class="mono-label text-idle">Next</span>
                                <span class="docs-pager-title">{next.title}</span>
                            </a>
                        )}
                    </nav>
                )
            }
        </article>

        {
            contents.length > 1 && (
                <aside class="docs-toc">
                    <p class="mono-label text-muted">On this page</p>
                    <nav aria-label="On this page">
                        <ul>
                            {contents.map((heading) => (
                                <li class:list={[heading.depth === 3 && 'is-nested']}>
                                    <a href={`#${heading.slug}`}>{heading.text}</a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </aside>
            )
        }
    </main>

    <Footer />
</Base>

<script>
    // Copy buttons on code blocks — an enhancement; the code stays selectable
    // without it. The button announces its result by changing its own label.
    if (navigator.clipboard) {
        for (const pre of document.querySelectorAll<HTMLPreElement>('[data-docs-prose] pre')) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'docs-copy';
            button.textContent = 'Copy';
            button.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(
                        pre.querySelector('code')?.innerText ?? pre.innerText
                    );
                    button.textContent = 'Copied';
                } catch {
                    button.textContent = 'Press Ctrl+C';
                }
                setTimeout(() => (button.textContent = 'Copy'), 2000);
            });
            const wrap = document.createElement('div');
            wrap.className = 'docs-code';
            pre.replaceWith(wrap);
            wrap.append(pre, button);
        }
    }

    // On narrow screens the sidebar collapses behind its summary; on wide
    // ones it is always open. `open` is the no-JS default.
    const toggle = document.querySelector<HTMLDetailsElement>('.docs-nav-toggle');
    if (toggle && window.matchMedia('(max-width: 1023px)').matches) toggle.open = false;
</script>
