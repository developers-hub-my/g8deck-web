---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Search from '../../components/docs/Search.astro';
import { groups } from '../../data/docs';
import { site } from '../../data/site';
import '../../styles/docs.css';
---

<Base
    title={`Documentation — ${site.name}`}
    description={`The ${site.name} documentation: connect a server, launch an application, run its databases, caches, storage and backups, and drive all of it from an AI client over MCP.`}
>
    <Nav />

    <main id="main" class="relative">
        <div
            class="drafting-grid pointer-events-none absolute inset-x-0 top-0 h-64 opacity-30"
            aria-hidden="true"
        >
        </div>

        <div class="page relative py-16 lg:py-20">
            <div class="max-w-6xl">
                <p class="mono-label text-accent">Documentation</p>
                <h1 class="h1 mt-6 max-w-3xl">Blueprint to running system.</h1>
                <p class="body-lg text-muted mt-6 max-w-2xl text-pretty">
                    Every guide follows the console screen by screen, in the order you would do the
                    work. New here? Start with your first deployment — about fifteen minutes, most
                    of it waiting on the pipeline.
                </p>

                <div class="mt-10 max-w-2xl">
                    <Search id="index-search" large />
                </div>

                <div class="mt-16">
                    {
                        groups.map((group) => (
                            <section
                                class="docs-index-group"
                                aria-labelledby={`group-${group.key}`}
                            >
                                <h2 id={`group-${group.key}`} class="mono-label text-muted">
                                    {group.label}
                                </h2>
                                <ul class="docs-index-grid">
                                    {group.docs.map((doc) => (
                                        <li>
                                            <a href={doc.href} class="card docs-index-card">
                                                <h3>{doc.title}</h3>
                                                <p class="text-pretty">{doc.description}</p>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        ))
                    }
                </div>

                <div class="border-line mt-16 border-t pt-8">
                    <p class="text-muted text-sm text-pretty">
                        The console itself lives at <a
                            href={site.consoleUrl}
                            class="text-accent hover:text-fg transition-colors"
                            >{new URL(site.consoleUrl).host}</a
                        >. These pages describe what it does today, checked against its source.
                    </p>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Base>
