---
/**
 * One route for every Markdown file in `src/docs`. The layout and the
 * sidebar are settled in Docs.astro; this file pairs a slug with its rendered
 * content, after screenshots are turned into enlargeable figures.
 */
import Docs from '../../layouts/Docs.astro';
import { docs } from '../../data/docs';
import { withScreenshots } from '../../components/docs/screenshots';

export function getStaticPaths() {
    return docs.map((doc) => ({
        params: { slug: doc.slug },
        props: { doc },
    }));
}

const { doc } = Astro.props;
const html = await withScreenshots(await doc.module.compiledContent());
---

<Docs doc={doc} headings={doc.module.getHeadings()}>
    <Fragment set:html={html} />
</Docs>
