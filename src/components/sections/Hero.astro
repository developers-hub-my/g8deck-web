---
import BlueprintCanvas from '../BlueprintCanvas.astro';
import StatusPill from '../StatusPill.astro';
import { hero, site } from '../../data/site';
---

<section class="relative overflow-hidden pt-16 pb-20 lg:pt-24 lg:pb-28">
    <!-- A faint drafting sheet behind the hero only, fading into the page. -->
    <div
        class="drafting-grid pointer-events-none absolute inset-0 [mask-image:linear-gradient(to_bottom,black,transparent_88%)] opacity-40"
        aria-hidden="true"
    >
    </div>

    <div class="page relative">
        <div
            class="content grid items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16"
        >
            <div>
                <p class="mono-label text-accent animate-rise">{hero.eyebrow}</p>

                <h1 class="h1 animate-rise mt-6" style="animation-delay: 60ms">
                    {hero.title}<br /><span class="text-accent">{hero.titleAccent}</span>
                </h1>

                <p
                    class="body-lg text-muted animate-rise mt-7 max-w-xl text-pretty"
                    style="animation-delay: 120ms"
                >
                    {hero.body}
                </p>

                <div class="animate-rise mt-9 flex flex-wrap gap-3" style="animation-delay: 180ms">
                    <a href={hero.primaryCta.href} class="btn btn-primary"
                        >{hero.primaryCta.label}</a
                    >
                    <a href={hero.secondaryCta.href} class="btn btn-ghost"
                        >{hero.secondaryCta.label}</a
                    >
                </div>

                <div
                    class="animate-rise mt-8 flex flex-wrap items-center gap-2"
                    style="animation-delay: 220ms"
                >
                    <StatusPill state="ok" label="saas" />
                    <StatusPill state="ok" label="on-prem" />
                    <StatusPill state="ok" label="air-gapped" />
                </div>
            </div>

            <div class="animate-rise" style="animation-delay: 240ms">
                <BlueprintCanvas />
            </div>
        </div>

        <!-- Stat strip -->
        <dl class="content border-line mt-16 grid grid-cols-2 gap-px border-t pt-10 lg:grid-cols-4">
            {
                hero.stats.map((stat) => (
                    <div class="pr-6">
                        <dt class="sr-only">{stat.label}</dt>
                        <dd>
                            <span
                                class="block text-[2.25rem] leading-none font-semibold tabular-nums"
                                style="font-variation-settings: 'wdth' 110"
                            >
                                {stat.value}
                            </span>
                            <span class="text-muted mt-2.5 block text-sm text-pretty">
                                {stat.label}
                            </span>
                        </dd>
                    </div>
                ))
            }
        </dl>

        <p class="content text-idle mono-label mt-10">
            Product console → {site.consoleUrl.replace('https://', '')}
        </p>
    </div>
</section>
