---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { compliance } from '../../data/site';
---

<Section id="compliance" index="07" label="COMPLIANCE">
    <SectionHead eyebrow="Trust" title={compliance.title} lede={compliance.body} />

    <div class="scroller mt-14" tabindex="0" role="region" aria-label="SOC 2 control mapping">
        <table class="w-full min-w-[44rem] border-collapse text-left">
            <caption class="sr-only">SOC 2 controls and the mechanism that enforces each</caption>
            <thead>
                <tr class="border-line border-b">
                    <th scope="col" class="mono-label text-muted w-20 pb-3">Control</th>
                    <th scope="col" class="mono-label text-muted w-52 pr-8 pb-3">Criterion</th>
                    <th scope="col" class="mono-label text-accent pb-3">Enforced by</th>
                </tr>
            </thead>
            <tbody>
                {
                    compliance.controls.map((row) => (
                        <tr class="border-line hover:bg-surface border-b transition-colors">
                            <td class="py-4 align-top">
                                <span class="mono-label text-accent">{row.code}</span>
                            </td>
                            <td class="py-4 pr-8 align-top font-medium">{row.name}</td>
                            <td class="text-muted py-4 align-top text-pretty">{row.detail}</td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <ul class="mt-12 grid gap-px sm:grid-cols-2">
        {
            compliance.guarantees.map((item) => (
                <li class="border-line bg-surface/40 flex gap-3 border p-5 text-sm">
                    <span class="text-accent mono-label mt-[3px] shrink-0" aria-hidden="true">
                        ✓
                    </span>
                    <span class="text-pretty">{item}</span>
                </li>
            ))
        }
    </ul>
</Section>
