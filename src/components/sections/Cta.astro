---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import networkSwitch from '../../assets/photos/network-switch.jpg';
import { mailto, photos, site } from '../../data/site';
---

<Section id="start" index="14" label="END" terminal>
    <!-- Decorative band: the copy sits on near-solid ink on the left, so its
         contrast never depends on the photograph. Credit is printed below. -->
    <div class="photo-band" aria-hidden="true">
        <Image
            src={networkSwitch}
            alt=""
            widths={[800, 1280, 1600]}
            sizes="100vw"
            loading="lazy"
            decoding="async"
        />
    </div>

    <div class="relative max-w-3xl">
        <p class="mono-label text-accent">Get started</p>
        <h2 class="h2 mt-5">See it provision a real machine.</h2>
        <p class="body-lg text-muted mt-6 text-pretty">
            Twenty minutes, on one of your servers or one of ours. You leave with a working
            deployment and a straight answer on whether this fits.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
            <a href={mailto('Book a 20-minute demo')} class="btn btn-primary">
                Book a 20-minute demo
            </a>
            <a href="/docs/first-deployment" class="btn btn-ghost">Read the walkthrough</a>
        </div>

        <p class="text-muted mt-8 text-sm text-pretty">
            Already have an account? <a
                href={site.consoleUrl}
                class="text-accent hover:text-fg transition-colors">Sign in to the console</a
            >. Or write to <a
                href={mailto('Question about G8Deck')}
                class="text-accent hover:text-fg transition-colors">{site.contact.email}</a
            > — it reaches the engineers, not a queue.
        </p>

        <p class="border-line text-muted mt-12 border-l-2 pl-4 text-sm text-pretty">
            We run it on ourselves: the console at {site.consoleUrl.replace('https://', '')} is a G8Deck-managed
            application, released by a push to main like any other.
        </p>
        <p class="mono-label text-muted mt-10">{photos.network.credit}</p>
    </div>
</Section>
