---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import Photo from '../art/Photo.astro';
import serverBays from '../../assets/photos/server-drive-bays.jpg';
import { photos, problem, problems } from '../../data/site';
---

<Section id="problem" index="01" label="PROBLEM">
    <div class="grid items-end gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-14">
        <SectionHead eyebrow={problem.eyebrow} title={problem.title} lede={problem.lede} />
        <Photo
            src={serverBays}
            alt={photos.serverBays.alt}
            credit={photos.serverBays.credit}
            ratio="3 / 2"
            sizes="(min-width: 1024px) 460px, 100vw"
        />
    </div>

    <div
        class="scroller mt-14"
        tabindex="0"
        role="region"
        aria-label="Most PaaS platforms compared with G8Deck"
    >
        <table class="w-full min-w-[42rem] border-collapse text-left">
            <thead>
                <tr class="border-line border-b">
                    <th scope="col" class="mono-label text-muted w-1/2 pr-8 pb-3"
                        >{problem.columns.theirs}</th
                    >
                    <th scope="col" class="mono-label text-accent pb-3">{problem.columns.ours}</th>
                </tr>
            </thead>
            <tbody>
                {
                    problem.assumptions.map((row) => (
                        <tr class="border-line hover:bg-surface border-b transition-colors">
                            <td class="text-muted py-4 pr-8 align-top">{row.theirs}</td>
                            <td class="py-4 align-top">{row.ours}</td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>

    <div class="mt-16 grid gap-px sm:grid-cols-2">
        {
            problems.map((item) => (
                <div class="border-line bg-surface/40 border p-6">
                    <h3 class="h3">{item.title}</h3>
                    <p class="text-muted mt-3 text-pretty">{item.body}</p>
                </div>
            ))
        }
    </div>
</Section>
