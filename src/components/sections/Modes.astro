---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { deployment } from '../../data/site';

const { columns, rows, commercial, note } = deployment;

/* The featured column is tinted top to bottom, so every cell needs to know. */
const columnClass = (index: number) => (columns[index].featured ? 'bg-surface/40' : '');

/* mono-label's 0.14em tracking overruns the row-label column on a phone, so the
   label is set tighter until there is room for the full drafting-label look. */
const rowLabel =
    'text-muted mono-label py-4 pr-3 align-top text-[0.5625rem] font-semibold tracking-[0.09em] sm:pr-6 sm:text-[0.6875rem] sm:tracking-[0.14em]';
---

<Section id="deployment" index="07" label="DEPLOYMENT">
    <SectionHead
        eyebrow="Where it runs"
        title="Two ways to run it. One control plane."
        lede="The same platform, the same blueprints and the same 24-step pipeline either way. What changes is who holds the control plane — everything below it stays yours in both."
    />

    <div class="mt-14">
        <table class="w-full table-fixed border-collapse text-left">
            <caption class="sr-only">
                SaaS and on-premise deployment compared, property by property
            </caption>
            <colgroup>
                <col class="w-[30%] sm:w-[26%]" />
                <col class="w-[35%] sm:w-[37%]" />
                <col class="w-[35%] sm:w-[37%]" />
            </colgroup>

            <thead>
                <tr>
                    <td></td>
                    {
                        columns.map((column, i) => (
                            <th
                                scope="col"
                                class:list={[
                                    'border-t-2 px-3 pt-4 pb-4 align-bottom sm:px-5',
                                    columnClass(i),
                                    column.featured ? 'border-t-accent' : 'border-t-line',
                                ]}
                            >
                                {/* nowrap: "On-Premise" otherwise breaks at its
                                    hyphen in a narrow column. */}
                                <span class="h3 block text-[1.0625rem] whitespace-nowrap sm:text-[1.375rem]">
                                    {column.name}
                                </span>
                            </th>
                        ))
                    }
                </tr>
            </thead>

            <tbody>
                {
                    rows.map((row) => (
                        <tr>
                            <th scope="row" class:list={['border-line border-t', rowLabel]}>
                                {row.label}
                            </th>
                            {row.values.map((value, i) => (
                                <td
                                    class:list={[
                                        'border-line border-t px-3 py-4 align-top text-sm text-pretty sm:px-5',
                                        columnClass(i),
                                        value === '—' ? 'text-idle' : '',
                                    ]}
                                >
                                    {value}
                                </td>
                            ))}
                        </tr>
                    ))
                }
            </tbody>

            <tfoot>
                <tr>
                    <th scope="row" class:list={['border-line-strong border-t-2', rowLabel]}>
                        {commercial.label}
                    </th>
                    {
                        commercial.values.map((value, i) => (
                            <td
                                class:list={[
                                    'border-line-strong border-t-2 px-3 py-4 align-top text-sm text-pretty sm:px-5',
                                    columnClass(i),
                                ]}
                            >
                                {value}
                            </td>
                        ))
                    }
                </tr>
            </tfoot>
        </table>

        <p class="text-muted mt-8 max-w-2xl text-sm text-pretty">{note}</p>
    </div>
</Section>
