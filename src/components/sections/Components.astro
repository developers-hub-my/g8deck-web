---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { componentMatrix, providers } from '../../data/site';

const total = componentMatrix.reduce((n, group) => n + group.items.length, 0);
---

<Section id="components" index="05" label="COMPONENTS">
    <SectionHead
        eyebrow="Breadth"
        title="Everything below your application, accounted for."
        lede={`${total} component types are modelled in one catalogue, placed through one contract. ${providers.shipped.length} server platforms can be adopted today, and MySQL, MariaDB, PostgreSQL and Redis install natively on them — the rest of the catalogue arrives with the container backends.`}
    />

    <div class="mt-14 space-y-px">
        {
            componentMatrix.map((group) => (
                <div class="border-line bg-surface/40 grid border sm:grid-cols-[10rem_1fr]">
                    <div class="border-line/70 px-5 py-4 sm:border-r">
                        <p class="mono-label text-accent">{group.group}</p>
                        <p class="text-idle mt-1.5 text-xs tabular-nums">
                            {group.items.length} types
                        </p>
                    </div>
                    <ul class="flex flex-wrap gap-1.5 px-5 py-4">
                        {group.items.map((item) => (
                            <li class="border-line-strong/60 text-muted rounded-[2px] border px-2 py-1 font-mono text-xs">
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    <div class="border-line mt-14 border-t pt-10">
        <p class="mono-label text-accent">Adopted today</p>
        <p class="text-muted mt-4 max-w-2xl text-pretty">
            You bring the machine; G8Deck bootstraps it over SSH and owns the lifecycle from there.
            SSH is the one thing that works identically on a rack in a data centre and on a cloud
            host, and the blueprint never names either.
        </p>
        <ul class="mt-6 flex flex-wrap gap-1.5">
            {
                providers.shipped.map((provider) => (
                    <li class="border-accent/40 text-fg rounded-[2px] border px-2.5 py-1.5 font-mono text-xs">
                        {provider}
                    </li>
                ))
            }
        </ul>

        {
            /* Two different absences, and collapsing them would misreport both:
            these drivers work and are held for beta, the ones below do not
            exist yet. */
        }
        <p class="mono-label text-idle mt-8">Built, held for beta</p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
            {
                providers.unreleased.map((provider) => (
                    <li class="border-line/80 text-idle rounded-[2px] border border-dashed px-2.5 py-1.5 font-mono text-xs">
                        {provider}
                    </li>
                ))
            }
        </ul>

        <p class="mono-label text-idle mt-8">Modelled, driver in progress</p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
            {
                providers.modelled.map((provider) => (
                    <li class="border-line/80 text-idle rounded-[2px] border border-dashed px-2.5 py-1.5 font-mono text-xs">
                        {provider}
                    </li>
                ))
            }
        </ul>
    </div>
</Section>
