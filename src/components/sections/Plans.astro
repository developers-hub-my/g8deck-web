---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { mailto, plans, site } from '../../data/site';
---

<Section id="plans" index="08" label="PLANS">
    <SectionHead eyebrow="Commercials" title={plans.title} lede={plans.body} />

    <div class="mt-14 grid gap-px lg:grid-cols-4">
        {
            plans.tiers.map((tier) => (
                <article
                    class:list={[
                        'border-line bg-surface/40 flex flex-col border border-t-2 p-6',
                        tier.featured ? 'border-t-accent' : 'border-t-transparent',
                    ]}
                >
                    <div class="flex items-baseline justify-between gap-2">
                        <h3 class="h3">{tier.name}</h3>
                        {tier.featured && <span class="mono-label text-accent">Popular</span>}
                    </div>
                    {/* Two lines reserved so the price row lines up across all
                        four cards regardless of where the descriptor wraps. */}
                    <p class="text-muted mt-2 min-h-[2.875rem] text-sm">{tier.for}</p>

                    {/* Negotiated sets in the muted weight a number would
                        overpower; a real price carries the full figure size. */}
                    <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                        <span
                            class:list={[
                                'leading-none font-semibold',
                                tier.price === 'Negotiated'
                                    ? 'text-idle text-[1.25rem]'
                                    : 'text-[1.75rem]',
                            ]}
                        >
                            {tier.price}
                        </span>
                        <span class="mono-label text-idle">{tier.period}</span>
                    </p>

                    <ul class="border-line/70 mt-6 mb-8 space-y-2.5 border-t pt-6 text-sm">
                        {tier.points.map((point) => (
                            <li class="flex gap-3">
                                <span
                                    class="bg-accent mt-[0.55rem] size-1 shrink-0 rounded-full"
                                    aria-hidden="true"
                                />
                                <span class="text-pretty">{point}</span>
                            </li>
                        ))}
                    </ul>
                    {/* "Get pricing" made sense while the price said TBC. With a
                        figure on the card, a priced tier sends you to the console
                        and only the negotiated one opens a conversation. */}
                    <a
                        href={
                            tier.price === 'Negotiated'
                                ? mailto(`Pricing enquiry — ${tier.name}`)
                                : site.consoleUrl
                        }
                        class:list={[
                            'btn btn-sm mt-auto w-full',
                            tier.featured ? 'btn-primary' : 'btn-ghost',
                        ]}
                    >
                        {tier.price === 'Negotiated' ? 'Talk to sales' : 'Get started'}
                    </a>
                </article>
            ))
        }
    </div>

    <p class="text-muted mt-8 max-w-2xl text-sm text-pretty">{plans.note}</p>
</Section>
