---
import Section from '../Section.astro';
import SectionHead from '../SectionHead.astro';
import { mailto, plans, site } from '../../data/site';
---

<Section id="plans" index="08" label="PLANS">
    <SectionHead eyebrow="Commercials" title={plans.title} lede={plans.body} />

    <div class="mt-14 grid gap-px lg:grid-cols-4">
        {
            plans.tiers.map((tier) => (
                <article
                    class:list={[
                        'border-line bg-surface/40 flex flex-col border border-t-2 p-6',
                        tier.featured ? 'border-t-accent' : 'border-t-transparent',
                    ]}
                >
                    <div class="flex items-baseline justify-between gap-2">
                        <h3 class="h3">{tier.name}</h3>
                        {tier.featured && <span class="mono-label text-accent">Popular</span>}
                    </div>
                    {/* Two lines reserved so the price row lines up across all
                        four cards regardless of where the descriptor wraps. */}
                    <p class="text-muted mt-2 min-h-[2.875rem] text-sm">{tier.for}</p>

                    {/* Negotiated sets in the muted weight a number would
                        overpower; a real price carries the full figure size. */}
                    <p class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                        <span
                            class:list={[
                                'leading-none font-semibold',
                                tier.price === 'Negotiated'
                                    ? 'text-idle text-[1.25rem]'
                                    : 'text-[1.75rem]',
                            ]}
                        >
                            {tier.price}
                        </span>
                        <span class="mono-label text-idle">{tier.period}</span>
                    </p>

                    <ul class="border-line/70 mt-6 mb-8 space-y-2.5 border-t pt-6 text-sm">
                        {tier.points.map((point) => (
                            <li class="flex gap-3">
                                <span
                                    class="bg-accent mt-[0.55rem] size-1 shrink-0 rounded-full"
                                    aria-hidden="true"
                                />
                                <span class="text-pretty">{point}</span>
                            </li>
                        ))}
                    </ul>
                    {/* "Get pricing" made sense while the price said TBC. With a
                        figure on the card, a priced tier sends you to the console
                        and only the negotiated one opens a conversation. */}
                    <a
                        href={
                            tier.price === 'Negotiated'
                                ? mailto(`Pricing enquiry — ${tier.name}`)
                                : site.consoleUrl
                        }
                        class:list={[
                            'btn btn-sm mt-auto w-full',
                            tier.featured ? 'btn-primary' : 'btn-ghost',
                        ]}
                    >
                        {tier.price === 'Negotiated' ? 'Talk to sales' : 'Get started'}
                    </a>
                </article>
            ))
        }
    </div>

    {
        /* The on-premise ladder is a price list, not four propositions — a table
        compares four capacity rows in a glance that four more cards cannot.
        Wrapped in .scroller so the widest row scrolls inside the box instead
        of pushing the page sideways on a phone. */
    }
    <div class="mt-16">
        <h3 class="h3">{plans.onPremise.heading}</h3>
        <p class="text-muted mt-2 max-w-2xl text-sm text-pretty">{plans.onPremise.caption}</p>

        <div class="scroller border-line mt-6 border-t">
            <table class="w-full min-w-[36rem] border-collapse text-left">
                <caption class="sr-only">
                    On-premise licence tiers, with annual price and capacity
                </caption>
                <thead>
                    <tr class="border-line/70 border-b">
                        {
                            plans.onPremise.columns.map((column, i) => (
                                <th
                                    scope="col"
                                    class:list={[
                                        'mono-label text-muted py-3 font-semibold',
                                        i === 0 ? 'pr-6' : 'px-3 text-right',
                                    ]}
                                >
                                    {column}
                                </th>
                            ))
                        }
                    </tr>
                </thead>
                <tbody>
                    {
                        plans.onPremise.tiers.map((tier) => (
                            <tr class="border-line/40 border-b last:border-b-0">
                                <th scope="row" class="py-4 pr-6 text-left align-top font-normal">
                                    <span class="block font-semibold">{tier.name}</span>
                                    <span class="text-muted mt-1 block text-sm text-pretty">
                                        {tier.for}
                                    </span>
                                </th>
                                <td class="mono-label px-3 py-4 text-right align-top text-[0.8125rem] tracking-normal">
                                    {tier.price}
                                </td>
                                <td class="px-3 py-4 text-right align-top text-sm">
                                    {tier.servers}
                                </td>
                                <td class="px-3 py-4 text-right align-top text-sm">{tier.seats}</td>
                                <td class="px-3 py-4 text-right align-top text-sm">{tier.cores}</td>
                            </tr>
                        ))
                    }
                </tbody>
            </table>
        </div>

        <a href={mailto('On-premise licence enquiry')} class="btn btn-sm btn-ghost mt-6">
            Request an on-premise quote
        </a>
    </div>

    <p class="text-muted mt-12 max-w-2xl text-sm text-pretty">{plans.note}</p>
    <p class="mono-label text-idle mt-4">USD · card · FPX · Touch ’n Go · annual invoicing</p>
</Section>
