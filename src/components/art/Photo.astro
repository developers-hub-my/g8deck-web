---
/**
 * Licensed photography, toned into the drafting sheet: desaturated and
 * darkened so it reads as part of the drawing rather than as stock colour —
 * colour on this page means state, and a photo must not borrow it. Always
 * lazy (every photo sits below the fold) and always credited in the caption;
 * the licence record is src/assets/photos/CREDITS.md.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    credit: string;
    sizes?: string;
    /** CSS aspect-ratio for the crop, e.g. "4 / 3". */
    ratio?: string;
    class?: string;
}

const {
    src,
    alt,
    credit,
    sizes = '(min-width: 1024px) 50vw, 100vw',
    ratio = '4 / 3',
    class: className = '',
} = Astro.props;
---

<figure class:list={['photo', className]}>
    <div class="photo__crop" style={`aspect-ratio: ${ratio}`}>
        <Image
            src={src}
            alt={alt}
            widths={[480, 800, 1200, 1600]}
            sizes={sizes}
            loading="lazy"
            decoding="async"
            class="photo__img"
        />
    </div>
    <figcaption class="mono-label text-muted mt-3">{credit}</figcaption>
</figure>
