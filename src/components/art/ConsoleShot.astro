---
/**
 * A real console capture on the drafting sheet: a thin sheet frame, corner
 * registration ticks, and a mono caption underneath that always says the data
 * is sample data. Rendered through astro:assets so it ships as responsive
 * WebP with its intrinsic size reserved (no layout shift).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    src: ImageMetadata;
    alt: string;
    caption: string;
    /** Above the fold: load eagerly with high priority. */
    priority?: boolean;
    sizes?: string;
    class?: string;
}

const {
    src,
    alt,
    caption,
    priority = false,
    sizes = '(min-width: 1280px) 1120px, 100vw',
    class: className = '',
} = Astro.props;
---

<figure class:list={['shot-frame', className]}>
    <div class="shot-frame__sheet">
        <Image
            src={src}
            alt={alt}
            widths={[640, 960, 1280, 1568]}
            sizes={sizes}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding="async"
            class="block h-auto w-full"
        />
    </div>
    <figcaption class="text-muted mt-4 max-w-3xl text-sm text-pretty">{caption}</figcaption>
</figure>
