---
import Logo from './Logo.astro';
import { mailto, nav, site } from '../data/site';

const isExternal = (href: string) => href.startsWith('http');
---

<header
    class="border-line bg-ink/85 sticky top-0 z-40 border-b backdrop-blur-lg supports-[backdrop-filter]:bg-[color-mix(in_oklab,var(--color-ink)_85%,transparent)]"
>
    <div class="page">
        <div class="content flex h-14 items-center justify-between gap-6">
            <a href="/" class="flex shrink-0 items-center" aria-label={`${site.name} home`}>
                <Logo class="h-6 w-auto" />
            </a>

            <nav class="hidden lg:block" aria-label="Primary">
                <ul class="flex items-center gap-7">
                    {
                        nav.map((item) =>
                            'children' in item ? (
                                <li class="group relative">
                                    {/* No JavaScript: the panel opens on hover and while focus is inside it. */}
                                    <button
                                        type="button"
                                        class="mono-label text-muted hover:text-fg group-focus-within:text-fg flex h-14 cursor-pointer items-center gap-1.5 transition-colors"
                                        aria-haspopup="true"
                                    >
                                        {item.label}
                                        <svg
                                            class="size-2.5 transition-transform group-focus-within:rotate-180 group-hover:rotate-180 motion-reduce:transition-none"
                                            viewBox="0 0 10 6"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            aria-hidden="true"
                                        >
                                            <path d="M1 1l4 4 4-4" />
                                        </svg>
                                    </button>
                                    <div class="invisible absolute top-full left-1/2 z-50 w-80 -translate-x-1/2 pt-1 opacity-0 transition-opacity duration-150 group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100 motion-reduce:transition-none">
                                        <ul class="border-line bg-surface border p-2 shadow-2xl shadow-black/50">
                                            {item.children.map((child) => (
                                                <li>
                                                    <a
                                                        href={child.href}
                                                        {...(isExternal(child.href) && {
                                                            target: '_blank',
                                                            rel: 'noopener noreferrer',
                                                        })}
                                                        class="hover:bg-raised group/link block rounded-[2px] px-3 py-2.5 transition-colors"
                                                    >
                                                        <span class="text-fg flex items-center gap-1.5 text-sm font-semibold">
                                                            {child.label}
                                                            {isExternal(child.href) && (
                                                                <span
                                                                    class="text-muted text-xs"
                                                                    aria-hidden="true"
                                                                >
                                                                    ↗
                                                                </span>
                                                            )}
                                                            {isExternal(child.href) && (
                                                                <span class="sr-only">
                                                                    {' '}
                                                                    (opens in a new tab)
                                                                </span>
                                                            )}
                                                        </span>
                                                        <span class="text-muted mt-0.5 block text-xs">
                                                            {child.note}
                                                        </span>
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </li>
                            ) : (
                                <li>
                                    <a
                                        href={item.href}
                                        class="mono-label text-muted hover:text-fg transition-colors"
                                    >
                                        {item.label}
                                    </a>
                                </li>
                            )
                        )
                    }
                </ul>
            </nav>

            <div class="flex items-center gap-2">
                <a href={site.consoleUrl} class="btn btn-sm btn-ghost hidden sm:inline-flex">
                    Sign in
                </a>
                <a
                    href={mailto('Talk to engineering')}
                    class="btn btn-sm btn-primary hidden sm:inline-flex"
                >
                    Talk to engineering
                </a>

                <!-- Mobile menu: native disclosure, no JavaScript. -->
                <details class="group relative lg:hidden">
                    <summary
                        class="btn btn-sm btn-ghost cursor-pointer list-none marker:content-none"
                        aria-label="Open navigation menu"
                    >
                        <span class="mono-label">Menu</span>
                    </summary>
                    <div
                        class="border-line bg-surface absolute right-0 z-50 mt-2 max-h-[calc(100dvh-5rem)] w-64 overflow-y-auto border p-2 shadow-2xl shadow-black/50"
                    >
                        <ul>
                            {
                                nav.map((item) =>
                                    'children' in item ? (
                                        <li class="border-line mb-1 border-b pb-1">
                                            <p class="mono-label text-idle px-3 pt-2.5 pb-1.5">
                                                {item.label}
                                            </p>
                                            <ul>
                                                {item.children.map((child) => (
                                                    <li>
                                                        <a
                                                            href={child.href}
                                                            {...(isExternal(child.href) && {
                                                                target: '_blank',
                                                                rel: 'noopener noreferrer',
                                                            })}
                                                            class="text-muted hover:bg-raised hover:text-fg block rounded-[2px] px-3 py-2 text-sm transition-colors"
                                                        >
                                                            {child.label}
                                                            {isExternal(child.href) && (
                                                                <span aria-hidden="true"> ↗</span>
                                                            )}
                                                        </a>
                                                    </li>
                                                ))}
                                            </ul>
                                        </li>
                                    ) : (
                                        <li>
                                            <a
                                                href={item.href}
                                                class="mono-label text-muted hover:bg-raised hover:text-fg block rounded-[2px] px-3 py-2.5 transition-colors"
                                            >
                                                {item.label}
                                            </a>
                                        </li>
                                    )
                                )
                            }
                        </ul>
                        <div class="border-line mt-2 grid gap-2 border-t pt-2 sm:hidden">
                            <a href={site.consoleUrl} class="btn btn-sm btn-ghost">Sign in</a>
                            <a href={mailto('Talk to engineering')} class="btn btn-sm btn-primary">
                                Talk to engineering
                            </a>
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </div>
</header>
